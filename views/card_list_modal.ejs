<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <title>Card Management</title>
  <!-- Bootstrap 5 CSS -->
  <!--link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"-->
  <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/united/bootstrap.min.css" rel="stylesheet">
  <!-- DataTables CSS -->
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css">

  <style>
    body {
      padding-top: 70px;
      /* ปรับตามความสูงของ Navbar */
    }

    td div:first-child {
      font-size: 1em;
      /* HEX ขนาดปกติ */
      font-weight: bold;
    }

    td div:last-child {
      font-size: 0.85em;
      /* DEC ขนาดเล็กกว่า */
      color: gray;
      /* สีเทา */
    }

    #fleet_checkbox_list {
      max-height: 180px;
      /* ปรับความสูงตามต้องการ */
      overflow-y: auto;
      border: 1px solid #ddd;
      padding: 8px;
      background: #fff;
    }

    .dataTables_wrapper {
      padding: 15px;
    }

    thead tr.filters input {
      width: 100%;
      padding: 3px;
      box-sizing: border-box;
    }

    .filters th {
      padding: 4px !important;
    }
  </style>
</head>

<body>
  <!-- เรียกใช้ Partial Navbar -->
  <%- include('partials/navbar') %>
    <% function leHexToBeHex(leHex) { %>
      <% if (!leHex) return '' ; %>
        <% const bytes=leHex.match(/.{1,2}/g); %>
          <% return bytes.reverse().join('').toUpperCase(); %>
            <% } %>
              <div class="container-fluid mt-4">
                <h1>Card Management</h1>

                <!-- ปุ่ม Add Card -->
                <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#cardModal"
                  onclick="openAddCardModal()">
                  Add Card
                </button>

                <!-- ตารางแสดง Card -->
                <table id="cardTable" class="table table-bordered table-striped table-hover">
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>UID</th>
                      <th>Issue Date</th>
                      <th>Status</th>
                      <th>Assigned Staff</th>
                      <th>Company</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (cards.length===0) { %>
                      <tr>
                        <td colspan="7" class="text-center">No card found.</td>
                      </tr>
                      <% } else { %>
                        <% cards.forEach(cd=> { %>
                          <tr>
                            <td>
                              <%= cd.card_id %>
                            </td>
                            <td>
                              <div>
                                <strong>
                                  <%= (cd.uid || '' ) %>
                                </strong> <!-- Big-Endian HEX -->
                              </div>
                              <div style="font-size: 0.85em; color: gray;">
                                <%= BigInt('0x' + leHexToBeHex(cd.uid || '' )).toString() || '' %> <!-- DEC -->
                              </div>
                            </td>
                            <td>
                              <%= cd.issue_date %>
                            </td>
                            <td>
                              <%= cd.status || '' %>
                            </td>
                            <td>
                              <%= cd.staff_name || '' %>
                            </td>
                            <td>
                              <%= cd.company_name || 'Unassigned' %>
                            </td>
                            <td>
                              <!-- ปุ่ม Edit -->
                              <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#cardModal"
                                onclick="openEditCardModal(
              <%= cd.card_id %>,
              <%= cd.staff_id %>,
              '<%= cd.issue_date %>',
              '<%= cd.status ? cd.status.replace(/'/g, '\\\'') : '' %>',
              '<%= cd.uid ? cd.uid.replace(/'/g, '\\\'') : '' %>',
              <%= cd.company_id == 0 ? cd.company_id : (cd.company_id || 'null') %>,
              <%= JSON.stringify(cd.fleet_ids || []) %>
            )">
                                Edit
                              </button>
                              <!-- ปุ่ม Delete -->
                              <form action="/management/card/delete/<%= cd.card_id %>" method="POST" class="d-inline"
                                onsubmit="return confirm('Are you sure you want to delete this card?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                  Delete
                                </button>
                              </form>
                            </td>
                          </tr>
                          <% }) %>
                            <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Modal สำหรับ Add/Edit Card -->
              <div class="modal fade" id="cardModal" tabindex="-1" aria-labelledby="cardModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <form id="cardForm" method="POST">
                      <div class="modal-header">
                        <h5 class="modal-title" id="cardModalLabel">Add Card</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <input type="hidden" id="cardId" />

                        <div class="mb-3">
                          <label for="uid" class="form-label">UID:</label>
                          <input type="text" class="form-control" id="uid" name="uid" required pattern="^[0-9a-fA-F]+$"
                            title="กรุณากรอกเลขฐาน 16 (0-9, a-f, A-F)">
                        </div>

                        <div class="mb-3">
                          <label for="company_id" class="form-label">Company:</label>
                          <select class="form-select" id="company_id" name="company_id"
                            onchange="updateAssignedStaff(); updateFleetList();">
                            <option value="">-- None --</option>
                            <% companies.forEach(company=> { %>
                              <option value="<%= company.id %>">
                                <%= company.name %>
                              </option>
                              <% }) %>
                          </select>
                        </div>

                        <div class="mb-3">
                          <label for="assigned_staff_id" class="form-label">Assigned Staff:</label>
                          <select class="form-select" id="assigned_staff_id" name="assigned_staff_id">
                            <option value="">-- Select a Company First --</option>
                          </select>
                        </div>

                        <div class="mb-3" id="copy_permissions_container" style="display: none;">
                          <label for="copy_card_id" class="form-label">Copy fleet permissions from:</label>
                          <select class="form-select" id="copy_card_id" onchange="copyPermissionsFromCard();">
                            <option value="">-- Select Card to Copy From --</option>
                          </select>
                        </div>

                        <div class="mb-3">
                          <label class="form-label">Fleets:</label>
                          <div class="mb-2">
                            <button type="button" class="btn btn-sm btn-outline-primary me-1"
                              onclick="selectAllFleets()">Select All</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                              onclick="clearAllFleets()">Clear All</button>
                          </div>
                          <div id="fleet_checkbox_list"
                            style="max-height: 180px; overflow-y: auto; border: 1px solid #ddd; padding: 8px; background: #fff;">
                            <span class="text-muted">-- Select a Company First --</span>
                          </div>
                        </div>

                        <div class="mb-3">
                          <label for="issue_date" class="form-label">Issue Date:</label>
                          <input type="date" class="form-control" id="issue_date" name="issue_date" required />
                        </div>

                        <div class="mb-3">
                          <label for="status" class="form-label">Status:</label>
                          <input type="text" class="form-control" id="status" name="status" />
                        </div>

                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                          Close
                        </button>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                          Save
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>

              <!-- jQuery และ DataTables JS -->
              <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
              <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
              <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
              <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
              <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>

              <!-- Bootstrap 5 JS -->
              <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

              <script>
                function openAddCardModal() {
                  document.getElementById('cardModalLabel').textContent = 'Add Card';
                  document.getElementById('cardForm').action = '/management/card/add';

                  // เคลียร์ฟอร์ม
                  document.getElementById('cardId').value = '';
                  document.getElementById('assigned_staff_id').selectedIndex = 0;
                  document.getElementById('company_id').selectedIndex = 0;
                  document.getElementById('fleet_checkbox_list').innerHTML = '<span class="text-muted">-- Select a Company First --</span>';
                  document.getElementById('copy_permissions_container').style.display = 'none';
                  document.getElementById('copy_card_id').innerHTML = '<option value="">-- Select Card to Copy From --</option>';

                  // กำหนด issue_date = วันที่ปัจจุบัน
                  const today = new Date();
                  const yyyy = today.getFullYear();
                  const mm = String(today.getMonth() + 1).padStart(2, '0');
                  const dd = String(today.getDate()).padStart(2, '0');
                  const defaultDate = `${yyyy}-${mm}-${dd}`;

                  document.getElementById('issue_date').value = defaultDate;
                  document.getElementById('status').value = '';
                  document.getElementById('uid').value = '';
                }

                // ฟังก์ชันเปิด Modal ในโหมด Edit Card
                function openEditCardModal(
                  cardId,
                  staffId,
                  issueDate,
                  status,
                  uid,
                  companyId,
                  fleetIds // รับ Fleet IDs ที่เกี่ยวข้อง
                ) {
                  document.getElementById('cardModalLabel').textContent = 'Edit Card';
                  document.getElementById('cardForm').action = '/management/card/edit/' + cardId;

                  document.getElementById('cardId').value = cardId;
                  document.getElementById('issue_date').value = issueDate;
                  document.getElementById('status').value = status;
                  document.getElementById('uid').value = uid;
                  document.getElementById('company_id').value = companyId;

                  updateAssignedStaff(() => {
                    document.getElementById('assigned_staff_id').value = staffId || '';
                  });
                  updateFleetList(fleetIds || []);
                }

                function leHexToBeHex(leHex) {
                  if (!leHex) return '';
                  const bytes = leHex.match(/.{1,2}/g);
                  return bytes.reverse().join('').toUpperCase();
                }

                function updateAssignedStaff(callback) {
                  const companyId = document.getElementById('company_id').value;
                  const assignedStaffDropdown = document.getElementById('assigned_staff_id');

                  // เคลียร์ตัวเลือกใน Dropdown
                  assignedStaffDropdown.innerHTML = '<option value="">-- Select a Company First --</option>';

                  // หากไม่มีการเลือกบริษัท (companyId เป็นค่าว่าง), ให้หยุดการทำงาน
                  if (companyId === '') {
                    if (callback) callback(); // เรียก Callback ถ้ามี
                    return;
                  }

                  // ดึงข้อมูลพนักงานที่เกี่ยวข้องกับบริษัทผ่าน API
                  fetch(`/management/staff/by-company/${companyId}`)
                    .then(response => response.json())
                    .then(data => {
                      if (data && data.staffs) {
                        assignedStaffDropdown.innerHTML = '<option value="">-- Select Staff --</option>';
                        data.staffs.forEach(staff => {
                          const option = document.createElement('option');
                          option.value = staff.id;
                          option.textContent = staff.name;
                          assignedStaffDropdown.appendChild(option);
                        });
                      }
                      if (callback) callback(); // เรียก Callback หลังจากโหลดข้อมูลสำเร็จ
                    })
                    .catch(error => {
                      console.error('Error fetching staff:', error);
                      if (callback) callback(); // เรียก Callback แม้เกิดข้อผิดพลาด
                    });
                }

                function updateFleetList(selectedFleetIds) {
                  const companyId = document.getElementById('company_id').value;
                  const fleetListDiv = document.getElementById('fleet_checkbox_list');
                  const copyPermissionsContainer = document.getElementById('copy_permissions_container');
                  const copyCardDropdown = document.getElementById('copy_card_id');

                  fleetListDiv.innerHTML = '<span class="text-muted">-- Select a Company First --</span>';
                  copyPermissionsContainer.style.display = 'none';
                  copyCardDropdown.innerHTML = '<option value="">-- Select Card to Copy From --</option>';

                  if (!companyId) return;

                  // แสดง Dropdown สำหรับคัดลอกสิทธิ์
                  copyPermissionsContainer.style.display = 'block';

                  // 1) ดึงรายการ Card ในบริษัทเดียวกันเพื่อคัดลอก
                  const currentCardId = document.getElementById('cardId').value;
                  fetch(`/management/card/by-company/${companyId}`)
                    .then(response => response.json())
                    .then(data => {
                      if (data && data.cards) {
                        data.cards.forEach(card => {
                          if (currentCardId && String(card.id) === String(currentCardId)) {
                            return; // ข้าม Card ปัจจุบัน
                          }
                          const option = document.createElement('option');
                          option.value = card.id;
                          option.textContent = card.staff_name ? `${card.staff_name} (${card.uid})` : `Unassigned (${card.uid})`;
                          copyCardDropdown.appendChild(option);
                        });
                      }
                    })
                    .catch(error => {
                      console.error('Error fetching cards by company:', error);
                    });

                  // 2) ดึงรายการ Fleet ในบริษัทเดียวกัน
                  fetch(`/management/fleet/by-company/${companyId}`)
                    .then(response => response.json())
                    .then(data => {
                      if (data && data.fleets) {
                        fleetListDiv.innerHTML = '';
                        if (data.fleets.length === 0) {
                          fleetListDiv.innerHTML = '<span class="text-muted">No fleets found for this company.</span>';
                          return;
                        }
                        data.fleets.forEach(fleet => {
                          const checkboxId = `fleet_${fleet.id}`;
                          const checked = selectedFleetIds && selectedFleetIds.includes(fleet.id) ? 'checked' : '';
                          fleetListDiv.innerHTML += `
                            <div class="form-check">
                              <input class="form-check-input" type="checkbox" name="fleet_ids" id="${checkboxId}" value="${fleet.id}" ${checked}>
                              <label class="form-check-label" for="${checkboxId}">${fleet.vehicle_name}</label>
                            </div>
                          `;
                        });
                      }
                    })
                    .catch(error => {
                      console.error('Error fetching fleets:', error);
                    });
                }

                function selectAllFleets() {
                  document.querySelectorAll('#fleet_checkbox_list input[type="checkbox"]').forEach(cb => cb.checked = true);
                }

                function clearAllFleets() {
                  document.querySelectorAll('#fleet_checkbox_list input[type="checkbox"]').forEach(cb => cb.checked = false);
                }

                function copyPermissionsFromCard() {
                  const copyCardId = document.getElementById('copy_card_id').value;
                  if (!copyCardId) return;

                  fetch(`/management/card/fleets/${copyCardId}`)
                    .then(response => response.json())
                    .then(data => {
                      if (data && data.fleetIds) {
                        const fleetIds = data.fleetIds.map(Number);
                        document.querySelectorAll('#fleet_checkbox_list input[type="checkbox"]').forEach(cb => {
                          cb.checked = fleetIds.includes(Number(cb.value));
                        });
                      }
                    })
                    .catch(error => {
                      console.error('Error copying permissions:', error);
                    });
                }

                document.getElementById('cardForm').addEventListener('submit', function (e) {
                  const uid = document.getElementById('uid').value.trim();
                  // ตรวจสอบว่าเป็นเลขฐาน 16 (0-9, a-f, A-F) และความยาวคู่
                  if (!/^[0-9a-fA-F]+$/.test(uid) || uid.length % 2 !== 0) {
                    alert('UID ต้องเป็นเลขฐาน 16 (0-9, a-f, A-F) และมีจำนวนหลักเป็นเลขคู่');
                    e.preventDefault();
                    return false;
                  }
                });

                $(document).ready(function () {
                  // เพิ่ม input สำหรับ filter แต่ละคอลัมน์
                  $('#cardTable thead tr')
                    .clone(true)
                    .addClass('filters')
                    .appendTo('#cardTable thead');

                  const table = $('#cardTable').DataTable({
                    pageLength: 10,
                    orderCellsTop: true,
                    fixedHeader: true,
                    order: [[0, 'desc']],
                    language: {
                      search: "ค้นหา:",
                      lengthMenu: "แสดง _MENU_ รายการ",
                      info: "แสดง _START_ ถึง _END_ จาก _TOTAL_ รายการ",
                      infoEmpty: "แสดง 0 ถึง 0 จาก 0 รายการ",
                      infoFiltered: "(กรองจากทั้งหมด _MAX_ รายการ)",
                      paginate: {
                        first: "หน้าแรก",
                        last: "หน้าสุดท้าย",
                        next: "ถัดไป",
                        previous: "ก่อนหน้า"
                      }
                    },
                    columnDefs: [
                      {
                        targets: -1,
                        orderable: false,
                        searchable: false
                      }
                    ],
                    initComplete: function () {
                      const api = this.api();

                      // สร้าง text inputs
                      api
                        .columns()
                        .eq(0)
                        .each(function (colIdx) {
                          // ไม่แสดง filter สำหรับคอลัมน์ Actions
                          if (colIdx === api.columns().nodes().length - 1) return;

                          const cell = $('.filters th').eq(colIdx);
                          const title = $(cell).text();
                          $(cell).html('<input type="text" class="form-control form-control-sm" placeholder="Filter ' + title + '" />');

                          // Handle keyup event
                          $('input', $('.filters th').eq(colIdx))
                            .on('keyup change', function () {
                              if (api.column(colIdx).search() !== this.value) {
                                api
                                  .column(colIdx)
                                  .search(this.value)
                                  .draw();
                              }
                            });
                        });
                    }
                  });
                });
              </script>
</body>

</html>