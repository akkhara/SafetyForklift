<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Map</title>
  <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/united/bootstrap.min.css" rel="stylesheet">
  <style>
    #map {
      height: 500px;
      width: 100%;
    }

    body {
      padding-top: 70px;
      /* ปรับตามความสูงของ Navbar */
    }

    #fleet-list {
      max-height: 500px;
      overflow-y: auto;
    }
  </style>
</head>

<body>
  <!-- Include Partial Navbar -->
  <%- include('partials/navbar') %>
  <div class="container-fluid mt-4">
    <h1>Map</h1>

    <!-- Filter Section -->
    <div class="row">
      <div class="col-md-3">
        <h5>Filter by Company</h5>
        <form id="filter-form">
          <select id="company-select" class="form-select">
            <option value="">-- Select Company --</option>
            <% companies.forEach(company => { %>
              <option value="<%= company.id %>"><%= company.name %></option>
            <% }); %>
          </select>
        </form>

        <!-- Fleet List -->
        <h5 class="mt-4">Fleet List</h5>
        <ul id="fleet-list" class="list-group">
          <!-- Fleet items will be dynamically added here -->
        </ul>
      </div>

      <div class="col-md-9">
        <div id="map"></div>
      </div>
    </div>
  </div>

  <!-- Leaflet.js CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // Initialize the map
    const map = L.map('map').setView([13.736717, 100.523186], 10); // Default location: Bangkok

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // Handle company selection
    const companySelect = document.getElementById('company-select');
    const fleetList = document.getElementById('fleet-list');

    companySelect.addEventListener('change', async () => {
      const companyId = companySelect.value;

      // Clear the fleet list
      fleetList.innerHTML = '';

      if (companyId) {
        // Fetch fleet data for the selected company
        const response = await fetch(`map/api/fleets?companyId=${companyId}`);
        const fleets = await response.json();

        // Populate the fleet list
        fleets.forEach(fleet => {
          const listItem = document.createElement('li');
          listItem.className = 'list-group-item';
          listItem.textContent = fleet.vehicle_name;
          fleetList.appendChild(listItem);
        });
      }
    });
  </script>

  <!-- Bootstrap 5 JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>