<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Map</title>
  <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/united/bootstrap.min.css" rel="stylesheet">
  <style>
    #map {
      height: 500px;
      width: 100%;
    }

    body {
      padding-top: 70px;
      /* ปรับตามความสูงของ Navbar */
    }

    #fleet-list {
      max-height: 500px;
      overflow-y: auto;
    }
  </style>
</head>

<body>
  <!-- Include Partial Navbar -->
  <%- include('partials/navbar') %>
  <div class="container-fluid mt-4">
    <h1>Real-Time Map</h1>

    <!-- Filter Section -->
    <div class="row">
      <div class="col-md-3">
        <h5>Filter by Company</h5>
        <form id="filter-form">
          <select id="company-select" class="form-select">
            <option value="">-- Select Company --</option>
            <% companies.forEach(company => { %>
              <option value="<%= company.id %>"><%= company.name %></option>
            <% }); %>
          </select>
        </form>

        <!-- Fleet List -->
        <h5 class="mt-4">Fleet List</h5>
        <ul id="fleet-list" class="list-group">
          <!-- Fleet items will be dynamically added here -->
        </ul>
      </div>

      <div class="col-md-9">
        <div id="map"></div>
      </div>
    </div>
  </div>

  <!-- Leaflet.js CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Socket.IO CDN -->
  <script src="/socket.io/socket.io.js"></script>

  <script>
    // Initialize the map
    const map = L.map('map').setView([13.736717, 100.523186], 10); // Default location: Bangkok

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // Initialize Socket.IO
    const socket = io();

    // Store markers by fleet ID
    const markers = {};

    // Listen for position updates
    socket.on('positionUpdate', (data) => {
      const { id, name, latitude, longitude, timestamp } = data;

      // If marker already exists, update its position
      if (markers[id]) {
        markers[id].setLatLng([latitude, longitude]);
        markers[id].bindPopup(`<b>${name}</b><br>Lat: ${latitude}, Lng: ${longitude}<br>Time: ${timestamp}`).openPopup();
      } else {
        // Create a new marker if it doesn't exist
        const marker = L.marker([latitude, longitude]).addTo(map);
        marker.bindPopup(`<b>${name}</b><br>Lat: ${latitude}, Lng: ${longitude}<br>Time: ${timestamp}`).openPopup();
        markers[id] = marker;
      }
    });

    // Handle company selection
    const companySelect = document.getElementById('company-select');
    const fleetList = document.getElementById('fleet-list');

    companySelect.addEventListener('change', async () => {
      const companyId = companySelect.value;

      // Clear the fleet list and remove all markers from the map
      fleetList.innerHTML = '';
      Object.values(markers).forEach(marker => map.removeLayer(marker));
      Object.keys(markers).forEach(key => delete markers[key]);

      if (companyId) {
        // Fetch fleet data for the selected company
        const response = await fetch(`/map/api/fleets?companyId=${companyId}`);
        const fleets = await response.json();

        // Create a bounds object to fit all markers
        const bounds = L.latLngBounds();

        // Populate the fleet list and add markers to the map
        fleets.forEach(fleet => {
          const { id, vehicle_name, latitude, longitude } = fleet;

          // Add to Fleet List
          const listItem = document.createElement('li');
          listItem.className = 'list-group-item';
          listItem.textContent = vehicle_name;
          fleetList.appendChild(listItem);

          // Add marker to the map
          if (latitude && longitude) {
            const marker = L.marker([latitude, longitude]).addTo(map);
            marker.bindPopup(`<b>${vehicle_name}</b><br>Lat: ${latitude}, Lng: ${longitude}`).openPopup();
            markers[id] = marker;

            // Extend bounds to include this marker
            bounds.extend([latitude, longitude]);
          }
        });

        // Zoom to fit all markers with padding
        if (bounds.isValid()) {
          map.fitBounds(bounds, { padding: [50, 50] }); // เพิ่ม padding 50px รอบขอบเขต
        }
      }
    });
  </script>

  <!-- Bootstrap 5 JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>