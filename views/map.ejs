<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Map</title>
  <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/united/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    #map {
      height: 500px;
      width: 100%;
    }

    body {
      padding-top: 70px;
      /* ปรับตามความสูงของ Navbar */
    }

    #fleet-list {
      max-height: 400px;
      overflow-y: auto;
    }

    .list-group-item.active {
      background-color: #007bff;
      color: white;
    }

    .col-md-3 {
      height: 500px;
      /* กำหนดความสูงให้เท่ากับแผนที่ */
    }

    #fleet-list {
      overflow-y: auto;
      /* เพิ่ม scroll หากรายการยาวเกิน */
    }

    .list-group-item.active {
      background-color: #007bff;
      color: white;
    }

    .fleet-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px;
      border-bottom: 1px solid #ddd;
      cursor: pointer;
    }

    .fleet-item:hover {
      background-color: #f8f9fa;
    }

    .fleet-item.active {
      background-color: #e9ecef;
    }

    .fleet-item .path-toggle-btn {
      width: 38px;
      height: 38px;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* เพิ่ม style สำหรับปุ่มไอคอน */
    .path-toggle-btn {
      width: 38px;
      height: 38px;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .path-toggle-btn i {
      font-size: 1.2em;
    }

    .fleet-item.active {
      background-color: #e9ecef;
    }

    .fleet-name:hover {
      color: #0d6efd;
      text-decoration: underline;
    }
  </style>
  <!-- Leaflet.markercluster CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster/dist/MarkerCluster.Default.css" />
</head>

<body>
  <!-- Include Partial Navbar -->
  <%- include('partials/navbar') %>
  <div class="container-fluid mt-4">
    <h1>Real-Time Map</h1>

    <div class="row">
      <!-- Filter Section -->
      <div class="col-md-3 d-flex flex-column">
        <h5>Filter by Company</h5>
        <form id="filter-form">
          <select id="company-select" class="form-select mb-3">
            <option value="">-- Select Company --</option>
            <% companies.forEach(company => { %>
            <option value="<%= company.id %>"><%= company.name %></option>
            <% }); %>
          </select>
        </form>

        <h5>Fleet List</h5>
        <ul id="fleet-list" class="list-group flex-grow-1">
          <!-- Fleet items will be dynamically added here -->
        </ul>
      </div>

      <!-- Map Section -->
      <div class="col-md-9">
        <div id="map"></div>
      </div>
    </div>
  </div>

  <!-- Leaflet.js CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Leaflet.markercluster JS -->
  <script src="https://unpkg.com/leaflet.markercluster/dist/leaflet.markercluster.js"></script>

  <!-- Socket.IO CDN -->
  <script src="/socket.io/socket.io.js"></script>

  <script>
    // Initialize the map
    const map = L.map('map').setView([13.736717, 100.523186], 10); // Default location: Bangkok

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    // สร้าง Cluster Group
    const markerClusterGroup = L.markerClusterGroup();
    map.addLayer(markerClusterGroup);

    // Initialize Socket.IO
    const socket = io();

    // Store markers by fleet ID
    const markers = {};
    const fleetPaths = {};  // ย้ายมาประกาศที่นี่

    // สร้าง Custom Icon สำหรับ Forklift
    const forkliftIcon = L.icon({
      iconUrl: '/images/forklift-icon.png', // Path ไปยังรูป Forklift
      iconSize: [32, 32], // ขนาดของไอคอน (กว้าง x สูง)
      iconAnchor: [16, 32], // จุดยึดของไอคอน (ตรงกลางด้านล่าง)
      popupAnchor: [0, -32] // ตำแหน่งของ Popup เมื่อเปิด
    });

    let selectedCompanyId = null;

    // Listen for position updates
    socket.on('positionUpdate', (data) => {
      const { id, name, latitude, longitude, timestamp, companyId, companyName } = data;
      console.log(`Received position update for ID: ${id}, Name: ${name}, Lat: ${latitude}, Lng: ${longitude}, Time: ${timestamp}, Company ID: ${companyId}`, 'Company ID:', companyName);
      // Update position only if the companyId matches the selectedCompanyId
      if (companyId === selectedCompanyId) {
        // If marker already exists, update its position
        if (markers[id]) {
          markers[id].setLatLng([latitude, longitude]);
          markers[id].bindPopup(`<b>${name}</b><br>Lat: ${latitude}, Lng: ${longitude}<br>Time: ${timestamp}`).openPopup();
        } else {
          // Create a new marker with the custom icon if it doesn't exist
          const marker = L.marker([latitude, longitude], { icon: forkliftIcon }).addTo(map);
          marker.bindPopup(`<b>${name}</b><br>Lat: ${latitude}, Lng: ${longitude}<br>Time: ${timestamp}`).openPopup();
          markers[id] = marker;
        }
      }
    });

    // Handle company selection
    const companySelect = document.getElementById('company-select');
    const fleetList = document.getElementById('fleet-list');

    // ย้ายฟังก์ชัน showFleetPath มาประกาศนอก event listener
    async function showFleetPath(fleetId) {
      // ลบเส้นทางเก่า (ถ้ามี)
      if (fleetPaths[fleetId]) {
        map.removeLayer(fleetPaths[fleetId]);
        delete fleetPaths[fleetId];
      }

      try {
        // ดึงข้อมูลประวัติตำแหน่ง
        const response = await fetch(`/map/api/fleet-history/${fleetId}`);
        const history = await response.json();

        if (history.length > 0) {
          // สร้างจุดสำหรับ polyline
          const pathPoints = history.map(point => [point.latitude, point.longitude]);

          // สร้าง polyline
          const polyline = L.polyline(pathPoints, {
            color: 'red',
            weight: 3,
            opacity: 0.5,
            smoothFactor: 1
          }).addTo(map);

          // เก็บ reference ของ polyline
          fleetPaths[fleetId] = polyline;

          // ซูมแผนที่ให้เห็นเส้นทางทั้งหมด
          map.fitBounds(polyline.getBounds());
        }
      } catch (error) {
        console.error('Error fetching fleet history:', error);
      }
    }

    // เก็บสถานะการแสดง path ของแต่ละ fleet
    const activeFleetPaths = {};

    // ฟังก์ชันสำหรับ toggle path
    async function toggleFleetPath(fleetId, button) {
      // ถ้ามี path แสดงอยู่แล้ว ให้ลบออก
      if (fleetPaths[fleetId]) {
        map.removeLayer(fleetPaths[fleetId]);
        delete fleetPaths[fleetId];
        activeFleetPaths[fleetId] = false;
        button.classList.remove('btn-success');
        button.classList.add('btn-primary');
        // ไม่ต้องเปลี่ยน textContent เพราะใช้ไอคอนแทน
        return;
      }

      // ถ้ายังไม่มี path ให้แสดง
      try {
        button.disabled = true;
        const response = await fetch(`/map/api/fleet-history/${fleetId}`);
        const history = await response.json();

        if (history.length > 0) {
          const pathPoints = history.map(point => [point.latitude, point.longitude]);
          const polyline = L.polyline(pathPoints, {
            color: 'red',
            weight: 3,
            opacity: 0.5,
            smoothFactor: 1
          }).addTo(map);

          fleetPaths[fleetId] = polyline;
          activeFleetPaths[fleetId] = true;
          map.fitBounds(polyline.getBounds());

          // เปลี่ยนสีปุ่มเท่านั้น ไม่ต้องเปลี่ยนข้อความ
          button.classList.remove('btn-primary');
          button.classList.add('btn-success');
        } else {
          const marker = markers[fleetId];
          if (marker) {
            const latLng = marker.getLatLng();
            map.setView(latLng, 15);
            marker.openPopup();
          }
          alert('No history data available for this fleet');
        }
      } catch (error) {
        console.error('Error fetching fleet history:', error);
      } finally {
        button.disabled = false;
      }
    }

    companySelect.addEventListener('change', async () => {
      selectedCompanyId = companySelect.value; // เก็บ companyId ที่เลือก

      // Clear the fleet list and remove all markers from the map
      fleetList.innerHTML = '';
      markerClusterGroup.clearLayers(); // ลบหมุดทั้งหมดใน Cluster Group
      Object.values(markers).forEach(marker => map.removeLayer(marker));
      Object.keys(markers).forEach(key => delete markers[key]);

      if (selectedCompanyId) {
        // Fetch fleet data for the selected company
        const response = await fetch(`/map/api/fleets?companyId=${selectedCompanyId}`);
        const fleets = await response.json();

        // Create a bounds object to fit all markers
        const bounds = L.latLngBounds();

        // Populate the fleet list and add markers to the map
        fleets.forEach(fleet => {
          const { id, vehicle_name, latitude, longitude } = fleet;

          // Add to Fleet List
          const listItem = document.createElement('li');
          listItem.className = 'list-group-item';
          listItem.textContent = vehicle_name;
          fleetList.appendChild(listItem);

          // Add marker to the cluster group
          if (latitude && longitude) {
            const marker = L.marker([latitude, longitude], { icon: forkliftIcon });
            marker.bindPopup(`<b>${vehicle_name}</b><br>Lat: ${latitude}, Lng: ${longitude}`).openPopup();
            markerClusterGroup.addLayer(marker); // เพิ่มหมุดลงใน Cluster Group
            markers[id] = marker;

            // Extend bounds to include this marker
            bounds.extend([latitude, longitude]);
          }

          // Add click event to Fleet List item
          listItem.addEventListener('click', () => {
            if (latitude && longitude) {
              // Zoom to the marker
              map.setView([latitude, longitude], 15); // Zoom to the marker with zoom level 15
              if (markers[id]) {
                markers[id].openPopup(); // Open the popup for the selected marker
              }

              // Highlight the selected item
              document.querySelectorAll('.list-group-item').forEach(item => {
                item.classList.remove('active'); // Remove active class from all items
              });
              listItem.classList.add('active'); // Add active class to the clicked item
            }
          });
        });

        // Zoom to fit all markers with padding
        if (bounds.isValid()) {
          map.fitBounds(bounds, { padding: [50, 50] }); // เพิ่ม padding 50px รอบขอบเขต
        }

        // ปรับการสร้าง fleet list
        fleetList.innerHTML = fleets.map(fleet => `
          <div class="fleet-item" onclick="zoomToFleet(${fleet.id}, '${fleet.vehicle_name}', this)">
              <span>${fleet.vehicle_name}</span>
              <button 
                  onclick="event.stopPropagation(); toggleFleetPath(${fleet.id}, this)" 
                  class="btn btn-sm btn-primary path-toggle-btn"
                  title="Show/Hide Path"
              >
                  <i class="fas fa-route"></i>
              </button>
          </div>
        `).join('');
      }
    });

    // เพิ่มฟังก์ชัน zoomToFleet
    async function zoomToFleet(fleetId, fleetName, itemElement) {
        const marker = markers[fleetId];
        if (marker) {
            const latLng = marker.getLatLng();
            map.setView(latLng, 15);
            marker.openPopup();

            // ไฮไลท์รายการที่เลือก
            document.querySelectorAll('.fleet-item').forEach(item => {
                item.classList.remove('active');
            });
            itemElement.classList.add('active');
        }
    }
  </script>

  <!-- Bootstrap 5 JS via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>