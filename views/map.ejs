<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Map</title>
  <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/united/bootstrap.min.css" rel="stylesheet">
  <style>
    #map {
      height: 500px;
      width: 100%;
    }

    body {
      padding-top: 70px;
      /* ปรับตามความสูงของ Navbar */
    }
  </style>
</head>

<body>
  <!-- Include Partial Navbar -->
  <%- include('partials/navbar') %>
    <div class="container-fluid mt-4">
      <h1>Map</h1>
      <div id="map"></div>
      <a href="/" class="btn btn-secondary mt-3">Back to Admin Home</a>
    </div>

    <!-- Leaflet.js CDN -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
      // Initialize the map
      const map = L.map('map').setView([13.736717, 100.523186], 10); // Default location: Bangkok

      // Add OpenStreetMap tiles
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
      }).addTo(map);

      // Example marker
      L.marker([13.736717, 100.523186]).addTo(map)
        .bindPopup('Default Location: Bangkok')
        .openPopup();
    </script>
    <!-- Bootstrap 5 JS via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>